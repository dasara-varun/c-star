module core

// Core primitive type aliases and helpers.
// Builtins (print, sqrt) are provided by the compiler runtime.

pub fn abs_i32(x: i32) -> i32 {
    if x < 0 {
        return -x
    }
    return x
}

pub fn abs_f64(x: f64) -> f64 {
    if x < 0.0 {
        return -x
    }
    return x
}

pub fn min_i32(a: i32, b: i32) -> i32 {
    if a < b {
        return a
    }
    return b
}

pub fn max_i32(a: i32, b: i32) -> i32 {
    if a > b {
        return a
    }
    return b
}
